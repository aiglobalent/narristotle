rules_version = '2';
// Narristotle Studio editorial data.
// Public site pages are static HTML (crawlable). Firestore holds the
// editorial workflow: drafts, scheduled posts, and publication history.
// Nothing in Firestore is publicly readable; only signed-in editors
// on the allowlist can read or write.
service cloud.firestore {
  match /databases/{database}/documents {
    function isEditor() {
      return request.auth != null &&
        request.auth.token.email in [
          "steve@aiglobalentertainment.com",
          "stephensmythe@gmail.com",
          "matt@aiglobalentertainment.com"
        ];
    }
    match /narristotle_posts/{postId} {
      allow read, write: if isEditor();
    }
    match /narristotle_history/{entryId} {
      allow read, write: if isEditor();
    }
  }
}
